{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Denti-Code U3",
  "version": "0.1.0",
  "identifier": "com.denticode.u3",
  "build": {
    "beforeDevCommand": "cd ../desktop && npx --no-install vite dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "cd ../desktop && npx --no-install vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Denti-Code U3",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://localhost:3010 https://localhost:3010"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "msi", "app", "dmg"],
    "icon": []
  }
}
