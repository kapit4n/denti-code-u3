{
  "name": "@denti-code-u3/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Denti-Code U3 REST API — Node.js + Fastify + TypeScript. The only process that touches PostgreSQL.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "test:integration": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@denti-code-u3/api-client": "workspace:*",
    "@denti-code-u3/database": "workspace:*",
    "@denti-code-u3/domain": "workspace:*",
    "@denti-code-u3/types": "workspace:*",
    "@denti-code-u3/validation": "workspace:*",
    "@fastify/cors": "11.3.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@denti-code-u3/config": "workspace:*",
    "@denti-code-u3/tsconfig": "workspace:*",
    "@types/node": "26.6.3",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
