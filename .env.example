# Denti-Code U3 — environment template
#
# Copy to `.env` (git-ignored) and adjust. Every variable is validated with Zod
# at startup by apps/api (see apps/api/src/config/env.ts) — the process refuses
# to boot with a missing or malformed value.

# ─── Shared ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Default timezone of the clinic. All appointment scheduling is interpreted in
# this timezone and stored as UTC. See docs/domain.md and docs/open-questions.md.
CLINIC_TIMEZONE=America/Argentina/Buenos_Aires
# The clinic this API process serves. Required: every clinical row is scoped by
# clinic_id and ADR 0014 forbids inferring scope from global state. Authentication
# does not exist yet, so this is the single-clinic assumption ADR 0014 permits.
# Must match a `clinics.id` row. `pnpm run db:seed` creates this one and prints
# the same value, so the two stay in step.
CLINIC_ID=11111111-1111-4111-8111-111111111111

# ─── API (apps/api) ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3010
# iso | pretty
LOG_LEVEL=info
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Database ─────────────────────────────────────────────────────────────
# SQLite by default (ADR 0025): a relative url resolves against the repository
# root; run `pnpm run db:migrate` and `pnpm run db:seed` once to create the file.
# PostgreSQL stays a supported second engine: set the postgres:// url below to a
# running instance (docker compose up, host port 5433) instead.
DATABASE_URL=sqlite:./data/denti-code-u3.db
# Used by pnpm run test:integration — PostgreSQL only; tests never touch the
# development database.
TEST_DATABASE_URL=postgres://denti:denti_dev_password@localhost:5433/denti_code_u3_test

# ─── Web app (apps/web) ───────────────────────────────────────────────────
# Must include the version prefix: ApiClient concatenates paths onto this
# value verbatim, and every route lives under /api/v1.
VITE_API_URL=http://localhost:3010/api/v1

# ─── Desktop app (apps/desktop) ──────────────────────────────────────────
# A desktop build may point at a different backend (clinic LAN vs cloud).
VITE_API_URL_DESKTOP=http://localhost:3010/api/v1