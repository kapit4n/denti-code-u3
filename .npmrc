# pnpm settings for the Denti-Code U3 monorepo.
# See https://pnpm.io/settings

# Fail instead of silently hoisting a dependency the package did not declare.
# A phantom dependency is a broken architectural boundary.
node-linker=isolated

# Peer dependencies are resolved from the workspace, not duplicated per package.
auto-install-peers=true
dedupe-peer-dependents=true
strict-peer-dependencies=false

# Keep builds reproducible.
prefer-workspace-packages=true
link-workspace-packages=true
resolution-mode=highest

# Never run lifecycle scripts of transitive dependencies (supply-chain hygiene).
# If a dependency legitimately needs one, enable it explicitly in that package.
ignore-scripts=false