{
  "name": "denti-code-u3",
  "version": "0.1.0",
  "private": true,
  "description": "Denti-Code U3 — modern dental clinic management system (Web + Desktop)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.6",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev:web": "turbo run dev --filter=@denti-code-u3/web",
    "dev:api": "turbo run dev --filter=@denti-code-u3/api",
    "dev:desktop": "turbo run dev --filter=@denti-code-u3/desktop",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && node scripts/check-boundaries.mjs",
    "lint:root": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "guard:boundaries": "node scripts/check-boundaries.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:migrate": "pnpm --filter @denti-code-u3/database run db:migrate",
    "db:seed": "pnpm --filter @denti-code-u3/database run db:seed",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "db:generate": "pnpm --filter @denti-code-u3/database run db:generate",
    "db:studio": "pnpm --filter @denti-code-u3/database run db:studio",
    "lint:eslint": "turbo run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.6.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
