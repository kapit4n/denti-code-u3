{
  "name": "@denti-code-u3/config",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Shared tooling configuration (TypeScript, ESLint, Prettier, Vitest, Tailwind) for Denti-Code U3",
  "exports": {
    "./typescript/*": "./typescript/*",
    "./eslint/base": "./eslint/base.mjs",
    "./eslint/react": "./eslint/react.mjs",
    "./eslint/node": "./eslint/node.mjs",
    "./vitest/node": "./vitest/node.ts",
    "./vitest/react": "./vitest/react.ts",
    "./tailwind": "./tailwind/index.ts"
  },
  "files": [
    "typescript",
    "eslint",
    "vitest",
    "tailwind"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "5.9.3",
    "@denti-code-u3/tsconfig": "workspace:*"
  }
}
